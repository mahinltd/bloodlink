{
  "info": {
    "name": "BloodLink API",
    "_postman_id": "bloodlink-api-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "healthUrl", "value": "http://localhost:3000" },
    { "key": "internalUrl", "value": "http://localhost:3000" },
    { "key": "jobSecret", "value": "replace-me" },
    { "key": "accessToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "releaseId", "value": "" }
  ],
  "item": [
    {
      "name": "Health and public",
      "item": [
        { "name": "Health", "request": { "method": "GET", "url": "{{healthUrl}}/healthz" } },
        { "name": "Bootstrap", "request": { "method": "GET", "url": "{{baseUrl}}/app/bootstrap" } },
        {
          "name": "Public content",
          "request": { "method": "GET", "url": "{{baseUrl}}/public/content" }
        },
        {
          "name": "Public requests",
          "request": { "method": "GET", "url": "{{baseUrl}}/public/requests" }
        },
        {
          "name": "Latest release",
          "request": { "method": "GET", "url": "{{baseUrl}}/download/latest" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Demo User\",\"email\":\"user@example.com\",\"phone\":\"01700000000\",\"password\":\"change-me\",\"acceptTerms\":true}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"password\":\"change-me\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"user@example.com\",\"code\":\"000000\"}"
            },
            "url": "{{baseUrl}}/auth/verify-email"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\":\"replace-me\"}" },
            "url": "{{baseUrl}}/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Mobile",
      "item": [
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/me"
          }
        },
        {
          "name": "Home",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/home"
          }
        },
        {
          "name": "Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/requests"
          }
        },
        {
          "name": "Request detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/requests/{{requestId}}"
          }
        },
        {
          "name": "Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/conversations"
          }
        },
        {
          "name": "Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/me"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/overview"
          }
        },
        {
          "name": "Admin users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Admin reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/reports"
          }
        },
        {
          "name": "Admin releases",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/releases"
          }
        },
        {
          "name": "Admin audit verify",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/audit/verify"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Uptime tick",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-job-secret", "value": "{{jobSecret}}" }],
            "url": "{{internalUrl}}/internal/tick"
          }
        },
        {
          "name": "Notification fanout",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-job-secret", "value": "{{jobSecret}}" }],
            "url": "{{internalUrl}}/internal/jobs/notification-fanout"
          }
        }
      ]
    }
  ]
}
