NODE_ENV=development
PORT=3000
API_RATE_LIMIT=120
APP_ENV=demo
APP_DOMAIN=bloodlink.tech
API_URL=https://api.bloodlink.tech
WEB_URL=https://bloodlink.tech
ADMIN_URL=https://admin.bloodlink.tech
CORS_ORIGINS=http://localhost:3000,https://bloodlink.tech,https://admin.bloodlink.tech

# MongoDB is required at runtime. Tests use mongodb-memory-server.
MONGODB_URI=mongodb://127.0.0.1:27017/bloodlink

# Use long random values outside local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

MAIL_DRIVER=console
MAIL_FROM=BloodLink <noreply@bloodlink.tech>
RESEND_API_KEY=
SUPPORT_EMAIL=support@bloodlink.tech
STORAGE_DRIVER=stub
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUSH_DRIVER=console
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_WEB_CLIENT_ID=
CALL_DRIVER=stub
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
JOB_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FIRST_SUPERADMIN_EMAIL=admin@bloodlink.tech
FIRST_SUPERADMIN_PASSWORD=replace-with-a-development-only-password
RELEASE_ALLOWED_HOSTS=
SEED_DEMO=false
SENTRY_DSN=
